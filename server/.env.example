# ── EduXo Server Environment ──────────────────────────
# Copy this to .env and fill in your values
# NEVER commit .env to git

NODE_ENV=development
PORT=3000

# MongoDB — local or Atlas
MONGO_URI=mongodb://localhost:27017/eduxo
# MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/eduxo

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=eduxo_prod_k29Pq7RZ4XvM8S2yA6nB3wL5mT1dF0jC

# CORS — comma-separated frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173

